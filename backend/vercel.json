{
  "installCommand": "npm install && cd ../frontend && npm install",
  "buildCommand": "cd ../frontend && npm run build && test -f public/index.html",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/config.js", "destination": "/api" },
    { "source": "/legacy/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/bot/cron/overdue-whatsapp",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/bot/cron/accept-nudge",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/delay-report/cron/monday-whatsapp",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/delay-report/cron/auto-reports",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/hr/cron/insurance-whatsapp",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/whatsapp/cron/weekly-plan-day-list",
      "schedule": "0 3 * * 1-6"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/config.js",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/legacy/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/apply",
      "destination": "/index.html"
    },
    {
      "source": "/apply/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/onboard",
      "destination": "/index.html"
    },
    {
      "source": "/onboard/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/site",
      "destination": "/index.html"
    },
    {
      "source": "/site/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/mdo",
      "destination": "/index.html"
    },
    {
      "source": "/mdo/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/client",
      "destination": "/index.html"
    },
    {
      "source": "/client/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/hr",
      "destination": "/index.html"
    },
    {
      "source": "/hr/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/|assets/|legacy/).*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "index.js"
    }
  }
}

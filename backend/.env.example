SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
JWT_SECRET=generate_a_long_random_string
PORT=4000

# WhatsApp Cloud API (server only — also set on Vercel)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Webhook verify token (Meta Developer Console → WhatsApp → Configuration)
META_WEBHOOK_VERIFY_TOKEN=dip-taskflow-wa
# Debounce bulk assign → one list message (ms)
WA_LIST_DEBOUNCE_MS=20000
# Utility template for weekly-plan day list (header day + body name/count/preview)
WHATSAPP_WEEKLY_PLAN_TEMPLATE=weekly_plan_day_list
# Optional fallback template when dedicated weekly-plan template fails / outside 24h
WHATSAPP_TASK_LIST_TEMPLATE=task_notification_v2
# Optional template language override (default en)
# WHATSAPP_TEMPLATE_LANG=en
# Optional legacy single-task Done Quick Reply template
WHATSAPP_TASK_DONE_TEMPLATE=
WHATSAPP_TASK_DONE_LANG=en

# DIP AI Bot (optional — without it, rule-based answers still work)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Overdue WhatsApp starts from this date (YYYY-MM-DD). Older overdue is not backfilled.
OVERDUE_WA_SINCE=2026-08-15

# All HR reminders (insurance + birthday) go ONLY to this WhatsApp number.
HR_WHATSAPP_NUMBER=9313605627
# Protect Vercel crons (Authorization: Bearer … or ?secret=)
CRON_SECRET=
